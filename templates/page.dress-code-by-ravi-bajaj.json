ight: 1.3;\n        margin: 0 0 24px 0;\n        color: #000;\n    }\n\n    .rb-layout-paragraph {\n        font-family: 'Georgia', serif;\n        font-size: 1.05rem;\n        line-height: 1.6;\n        margin: 0 0 24px 0;\n        color: #222;\n    }\n\n    /* 30% Width Image Section on the Right */\n    .rb-layout-image-section {\n        width: 50%;\n        position: -webkit-sticky;\n        position: sticky;\n            top: 150px;\n    }\n\n    .rb-layout-img {\n        display: block;\n        width: 100%;\n        height: auto;\n        object-fit: cover;\n        border-radius: 4px;\n    }\n\n    /* Mobile Responsive adjustments */\n    @media (max-width: 768px) {\n        .rb-layout-container {\n            flex-direction: column-reverse; /* Places image on top for mobile screens */\n            gap: 24px;\n        }\n        .rb-layout-text-section,\n        .rb-layout-image-section {\n            width: 100%;\n            position: static;\n        }\n    }\n</style>",
