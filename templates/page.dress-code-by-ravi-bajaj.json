olor: #000;\n}\n\n.rb-layout-paragraph {\n    margin: 0;\n    font-size: 1.05rem;\n    line-height: 1.7;\n    font-family: Georgia, serif;\n    color: #222;\n}\n\n/* Mobile */\n@media (max-width: 768px) {\n    .rb-layout-container {\n        flex-direction: column;\n        gap: 24px;\n    }\n\n    .rb-layout-image-section,\n    .rb-layout-text-section {\n        width: 100%;\n        position: static;\n    }\n}\n</style>",
