{% doc %}
  @prompt
    {% assign section_id = section.id %}
    
    <style>
    #image-split-{{ section_id }}{
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    
    #image-split-{{ section_id }} .image-wrapper{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:{{ section.settings.desktop_gap }}px;
    }
    
    #image-split-{{ section_id }} .image-box img{
      width:100%;
      height:auto;
      display:block;
      border-radius:{{ section.settings.image_radius }}px;
    }
    
    @media screen and (max-width:749px){
    
    #image-split-{{ section_id }}{
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }
    
    #image-split-{{ section_id }} .image-wrapper{
      grid-template-columns:1fr;
      gap:{{ section.settings.mobile_gap }}px;
    }
    
    }
    </style>
    
    <section id="image-split-{{ section_id }}">
      <div class="page-width">
    
        <div class="image-wrapper">
    
          <div class="image-box">
            {% if section.settings.image_1 != blank %}
              {{
                section.settings.image_1
                | image_url: width: 2000
                | image_tag: loading: 'lazy'
              }}
            {% endif %}
          </div>
    
          <div class="image-box">
            {% if section.settings.image_2 != blank %}
              {{
                section.settings.image_2
                | image_url: width: 2000
                | image_tag: loading: 'lazy'
              }}
            {% endif %}
          </div>
    
        </div>
    
      </div>
    </section>
    
    {% schema %}
    {
      "name": "Split Images",
      "settings": [
        {
          "type":"image_picker",
          "id":"image_1",
          "label":"Left Image"
        },
        {
          "type":"image_picker",
          "id":"image_2",
          "label":"Right Image"
        },
    
        {
          "type":"range",
          "id":"desktop_gap",
          "label":"Desktop Gap",
          "min":0,
          "max":100,
          "step":2,
          "default":20,
          "unit":"px"
        },
        {
          "type":"range",
          "id":"mobile_gap",
          "label":"Mobile Gap",
          "min":0,
          "max":60,
          "step":2,
          "default":15,
          "unit":"px"
        },
    
        {
          "type":"range",
          "id":"padding_top",
          "label":"Desktop Padding Top",
          "min":0,
          "max":150,
          "step":5,
          "default":40,
          "unit":"px"
        },
        {
          "type":"range",
          "id":"padding_bottom",
          "label":"Desktop Padding Bottom",
          "min":0,
          "max":150,
          "step":5,
          "default":40,
          "unit":"px"
        },
    
        {
          "type":"range",
          "id":"mobile_padding_top",
          "label":"Mobile Padding Top",
          "min":0,
          "max":100,
          "step":5,
          "default":20,
          "unit":"px"
        },
        {
          "type":"range",
          "id":"mobile_padding_bottom",
          "label":"Mobile Padding Bottom",
          "min":0,
          "max":100,
          "step":5,
          "default":20,
          "unit":"px"
        },
    
        {
          "type":"range",
          "id":"image_radius",
          "label":"Image Border Radius",
          "min":0,
          "max":50,
          "step":2,
          "default":0,
          "unit":"px"
        }
      ],
      "presets":[
        {
          "name":"Split Images"
        }
      ]
    }
    {% endschema %}
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-images-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-split-images-wrapper-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.desktop_gap }}px;
  }

  .ai-split-images-box-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-split-images-box-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_radius }}px;
  }

  .ai-split-images-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-split-images-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .ai-split-images-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
    }

    .ai-split-images-wrapper-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }
  }
{% endstyle %}

<div class="ai-split-images-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-images-wrapper-{{ ai_gen_id }}">
    <div class="ai-split-images-box-{{ ai_gen_id }}">
      {% if block.settings.image_1 != blank %}
        {{
          block.settings.image_1
          | image_url: width: 2000
          | image_tag: loading: 'lazy', width: block.settings.image_1.width, height: block.settings.image_1.height
        }}
      {% else %}
        <div class="ai-split-images-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="ai-split-images-box-{{ ai_gen_id }}">
      {% if block.settings.image_2 != blank %}
        {{
          block.settings.image_2
          | image_url: width: 2000
          | image_tag: loading: 'lazy', width: block.settings.image_2.width, height: block.settings.image_2.height
        }}
      {% else %}
        <div class="ai-split-images-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
  </div>
</div>

